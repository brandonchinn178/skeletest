  , recover-rtti:ghc-heap
  , recover-rtti:ghc-prim
  , scientific:base
  , scientific:template-haskell
  , semialign:base
  , sop-core:base
  , these:base
  , time-compat:base
  , time-compat:time
  , unordered-containers:template-haskell
  , uuid-types:template-haskell
